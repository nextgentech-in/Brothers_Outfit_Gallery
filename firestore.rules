rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authority comes only from a verified email or the protected admins
    // collection. Never trust role/isAdmin fields on a user-editable profile.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['setupatel01@gmail.com', 'setupatel441@gmail.com'] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Admin Collection: stores verified admin roles; only existing admins can manage
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Products: public read; admin write only
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: created only by the trusted server (Firebase Admin SDK bypasses these
    // rules). Browser clients may read their own orders, request cancellation, or link an exchange request.
    match /orders/{orderId} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.token.email));
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledAt', 'updatedAt']) &&
           request.resource.data.status == 'Cancelled') ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasExchangeRequest', 'latestExchangeId', 'latestExchangeStatus', 'updatedAt']) &&
           request.resource.data.latestExchangeStatus == 'PENDING_ADMIN_REVIEW')
        )
      );
      allow delete: if isAdmin();
    }

    // User Profiles: owner can read/write; users cannot set or escalate isAdmin privileges
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
                    !request.resource.data.keys().hasAny(['isAdmin', 'role']);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'role'])
      );
      allow delete: if isAdmin();
    }

    // Coupons: public read for checkout validation; admin write only
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: public read; authenticated customers can post; admin can moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Store Settings: public read; admin write only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications are generated by the trusted server only.
    match /notifications/{notificationId} {
      allow read, update, delete, create: if isAdmin();
    }

    // Exchange Requests: Customers can read their own exchange requests and submit new requests.
    // When created by a customer, status must be PENDING_ADMIN_REVIEW and userId must match.
    // Admin has full management access (approval, rejection, reverse pickup scheduling).
    match /exchangeRequests/{exchangeId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING_ADMIN_REVIEW'
      );
      allow update, delete: if isAdmin();
    }

    // Customer In-App Notifications: Customers can read and mark their own notifications as read.
    match /customerNotifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
      );
      allow create, delete: if isAdmin();
    }
  }
}
